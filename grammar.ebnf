(* ============================================================ *)
(*  Language Grammar — EBNF                                     *)
(*  Version 0.1                                                 *)
(*                                                              *)
(*  Notation:                                                   *)
(*    =       definition                                         *)
(*    |       alternation                                        *)
(*    [ ]     optional                                           *)
(*    { }     zero or more repetitions                           *)
(*    ( )     grouping                                           *)
(*    " "     terminal string                                    *)
(*    (* *)   comment                                            *)
(* ============================================================ *)


(* ── TOP LEVEL ─────────────────────────────────────────────── *)

file
    = { top_level_decl } ;

top_level_decl
    = [ "pub" ] ( var_decl
                | const_decl
                | fn_decl
                | struct_decl
                | enum_decl
                | union_decl
                | when_block )
    | doc_comment top_level_decl ;


(* ── COMMENTS ──────────────────────────────────────────────── *)

line_comment
    = "//" { any_char_except_newline } newline ;

block_comment
    = "/*" { any_char } "*/" ;

doc_comment
    = "///" { any_char_except_newline } newline ;

comment
    = line_comment | block_comment | doc_comment ;


(* ── IDENTIFIERS & LITERALS ────────────────────────────────── *)

ident
    = ( letter | "_" ) { letter | digit | "_" } ;

letter
    = "a" .. "z" | "A" .. "Z" ;

digit
    = "0" .. "9" ;

int_literal
    = digit { digit } ;

float_literal
    = digit { digit } "." digit { digit } ;

bool_literal
    = "true" | "false" ;

char_literal
    = "'" ( escape_seq | any_char_except_quote ) "'" ;

string_literal
    = '"' { escape_seq | any_char_except_dquote } '"' ;

escape_seq
    = "\\" ( "n" | "t" | "r" | "\\" | "'" | '"' | "0" ) ;

literal
    = int_literal
    | float_literal
    | bool_literal
    | char_literal
    | string_literal ;


(* ── TYPES ─────────────────────────────────────────────────── *)

type
    = primitive_type
    | pointer_type
    | slice_type
    | array_type
    | fn_type
    | named_type
    | builtin_generic_type ;

primitive_type
    = "i8"  | "i16" | "i32" | "i64"
    | "u8"  | "u16" | "u32" | "u64"
    | "f32" | "f64"
    | "bool"
    | "char"
    | "void"
    | "isize"
    | "usize" ;

pointer_type
    = "*" [ "const" ] type ;

slice_type
    = "[" "]" [ "const" ] type ;

array_type
    = "[" expr "]" type ;

fn_type
    = "fn" "(" [ fn_type_param_list ] ")" type ;

fn_type_param_list
    = type { "," type } ;

named_type
    = ident { "::" ident } ;

(* Result(T, E) and Option(T) — built-in until generics land *)
builtin_generic_type
    = "Result" "(" type "," type ")"
    | "Option" "(" type ")" ;


(* ── DECLARATIONS ──────────────────────────────────────────── *)

var_decl
    = [ "comptime" ] "var" ident [ ":" type ] "=" expr ";" ;

const_decl
    = [ "comptime" ] "const" ident [ ":" type ] "=" expr ";" ;


(* ── FUNCTIONS ─────────────────────────────────────────────── *)

fn_decl
    = { attribute } "fn" ident "(" [ param_list ] ")" type
      ( block | ";" ) ;

param_list
    = param { "," param } ;

param
    = [ "mut" ] ident ":" param_type
    | variadic_param ;

param_type
    = pointer_type | slice_type | array_type | primitive_type | named_type | builtin_generic_type ;

variadic_param
    = "..." ( type | "any" ) ;

(* lambda — anonymous function, no capture *)
lambda_expr
    = "fn" "(" [ param_list ] ")" type block ;


(* ── ATTRIBUTES ────────────────────────────────────────────── *)

attribute
    = "@" ident [ "(" [ attr_arg_list ] ")" ] ;

attr_arg_list
    = attr_arg { "," attr_arg } ;

attr_arg
    = literal | ident ;


(* ── STRUCTS ───────────────────────────────────────────────── *)

struct_decl
    = "const" ident "=" "struct" "{" { struct_member } "}" ";" ;

struct_member
    = struct_field
    | fn_decl ;

struct_field
    = ident ":" type [ ":" int_literal ]   (* optional bit width *)
      "," ;


(* ── ENUMS ─────────────────────────────────────────────────── *)

enum_decl
    = "const" ident "=" "enum" [ ":" primitive_type ]
      "{" { enum_variant } { fn_decl } "}" ";" ;

enum_variant
    = ident [ enum_variant_data ] [ "=" int_literal ] "," ;

enum_variant_data
    = "(" type_list ")"                   (* positional *)
    | "{" named_field_list "}" ;          (* named fields *)

type_list
    = type { "," type } ;

named_field_list
    = named_field { "," named_field } ;

named_field
    = ident ":" type ;


(* ── UNIONS ────────────────────────────────────────────────── *)

union_decl
    = "const" ident "=" "union" "{" { union_field } "}" ";" ;

union_field
    = ident ":" type "," ;


(* ── STATEMENTS ────────────────────────────────────────────── *)

stmt
    = var_decl
    | const_decl
    | assign_stmt
    | compound_assign_stmt
    | expr_stmt
    | return_stmt
    | if_stmt
    | while_stmt
    | for_stmt
    | loop_stmt
    | match_stmt
    | when_block
    | goto_stmt
    | break_stmt
    | continue_stmt
    | block ;

block
    = "{" { stmt } "}" ;

assign_stmt
    = expr "=" expr ";" ;

compound_assign_stmt
    = expr compound_op expr ";" ;

compound_op
    = "+=" | "-=" | "*=" | "/=" | "%="
    | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

expr_stmt
    = expr ";" ;

return_stmt
    = "return" [ expr ] ";" ;

goto_stmt
    = "goto" ident ";" ;

break_stmt
    = "break" ";" ;

continue_stmt
    = "continue" ";" ;


(* ── CONTROL FLOW ──────────────────────────────────────────── *)

if_stmt
    = "if" expr block { "else" "if" expr block } [ "else" block ] ;

while_stmt
    = "while" expr block ;

loop_stmt
    = "loop" block ;

for_stmt
    = "for" for_init ";" expr ";" for_post block ;

for_init
    = var_decl_inline ;

(* inline var decl without trailing semicolon — used in for *)
var_decl_inline
    = "var" ident [ ":" type ] "=" expr ;

for_post
    = expr compound_assign_stmt_inline | assign_stmt_inline ;

compound_assign_stmt_inline
    = compound_op expr ;

assign_stmt_inline
    = "=" expr ;


(* ── MATCH ─────────────────────────────────────────────────── *)

match_stmt
    = "match" expr "{" { match_arm } "}" ;

match_arm
    = match_pattern "=>" ( block | expr "," ) ;

match_pattern
    = "_"                                  (* wildcard *)
    | literal                              (* exact value *)
    | range_pattern                        (* 1..5 *)
    | enum_pattern                         (* Shape::Circle(r) *)
    | named_enum_pattern                   (* Shape::Box{ w, h } *)
    | ident ;                              (* bind to variable *)

range_pattern
    = literal ".." literal ;

enum_pattern
    = ident "::" ident [ "(" bind_list ")" ] ;

named_enum_pattern
    = ident "::" ident "{" bind_list "}" ;

bind_list
    = ident { "," ident } ;


(* ── WHEN (conditional compilation) ───────────────────────── *)

when_block
    = "when" builtin_call block { "else" "when" builtin_call block } [ "else" block ] ;


(* ── EXPRESSIONS ───────────────────────────────────────────── *)

expr
    = ternary_expr ;

ternary_expr
    = logical_or_expr [ "?" expr ":" expr ] ;

logical_or_expr
    = logical_and_expr { "||" logical_and_expr } ;

logical_and_expr
    = equality_expr { "&&" equality_expr } ;

equality_expr
    = relational_expr { ( "==" | "!=" ) relational_expr } ;

relational_expr
    = bitwise_or_expr { ( "<" | ">" | "<=" | ">=" ) bitwise_or_expr } ;

bitwise_or_expr
    = bitwise_xor_expr { "|" bitwise_xor_expr } ;

bitwise_xor_expr
    = bitwise_and_expr { "^" bitwise_and_expr } ;

bitwise_and_expr
    = shift_expr { "&" shift_expr } ;

shift_expr
    = additive_expr { ( "<<" | ">>" ) additive_expr } ;

additive_expr
    = multiplicative_expr { ( "+" | "-" ) multiplicative_expr } ;

multiplicative_expr
    = unary_expr { ( "*" | "/" | "%" ) unary_expr } ;

unary_expr
    = ( "-" | "!" | "~" | "*" | "&" ) unary_expr
    | postfix_expr ;

postfix_expr
    = primary_expr { postfix_op } ;

postfix_op
    = "." ident                            (* field access *)
    | "::" ident                           (* enum variant access *)
    | "[" expr "]"                         (* index *)
    | "[" expr ".." expr "]"              (* slice *)
    | "(" [ call_arg_list ] ")"           (* call *)
    | "!"                                  (* unwrap or panic *)
    | "catch" expr                         (* catch postfix *)
    | "as" type                            (* cast *)
    | ".len"                               (* slice length *)
    | ".ptr" ;                             (* slice pointer *)

primary_expr
    = literal
    | ident
    | lambda_expr
    | struct_init
    | array_init
    | builtin_call
    | try_expr
    | "(" expr ")" ;

try_expr
    = "try" expr ;

struct_init
    = ident "{" [ struct_init_field_list ] "}" ;

struct_init_field_list
    = struct_init_field { "," struct_init_field } ;

struct_init_field
    = "." ident "=" expr ;

array_init
    = "{" [ expr { "," expr } ] "}" ;

call_arg_list
    = expr { "," expr } ;


(* ── BUILTIN CALLS ─────────────────────────────────────────── *)

builtin_call
    = "@" ident "(" [ builtin_arg_list ] ")" ;

builtin_arg_list
    = builtin_arg { "," builtin_arg } ;

builtin_arg
    = expr
    | "." "{" builtin_named_field_list "}" ;   (* .{ .field = value } *)

builtin_named_field_list
    = builtin_named_field { "," builtin_named_field } ;

builtin_named_field
    = "." ident "=" builtin_field_value ;

builtin_field_value
    = "{" string_literal { "," string_literal } "}"   (* string set *)
    | expr ;


(* ── KNOWN BUILTINS ────────────────────────────────────────── *)

(*
    @import("path")                        import module
    @cimport("header.h")                   import C header
    @cimport("header.h", .{                import STB-style
        .defines = {"DEFINE_1", ...}
    })
    @size(T)                               size of type (comptime)
    @os("linux")                           OS check (comptime)
    @extern                                used as attribute
    @inline                                used as attribute
    @export                                used as attribute
    @cdecl                                 used as attribute
    @packed                                used as attribute
    @align(N)                              used as attribute
*)


(* ── LABELS (for goto) ─────────────────────────────────────── *)

label_decl
    = ident ":" ;

(* goto target — label_decl appears as a statement *)
(* goto_stmt references the label by ident         *)
